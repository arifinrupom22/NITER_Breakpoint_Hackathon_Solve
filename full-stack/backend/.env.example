# NITER Smart Transport backend configuration.
# Copy this file to .env and fill in real values. Never commit .env.
NITER_PORT=3001
JWT_SECRET=niter-demo-secret-change-me-in-production-9f2c1a
# AI: OpenRouter-compatible endpoint. Leave AI_API_KEY empty to run the
# fully-offline rule-based assistant (the default for hackathon demo).
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Demo simulation: buses move along routes on a compressed timeline.
DEMO_MODE=true
SIM_TIME_SCALE=12
